DATABASE_URL=postgres://nexus_app:nexus_app@localhost:5433/nexus
AUTH_DATABASE_URL=postgres://nexus_auth:nexus_auth@localhost:5433/nexus
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/nexus
# ---- Online database (Neon, recommended for "everything online") ----
# 1. Create a free project at https://neon.tech, then paste its URLs here:
#    - DATABASE_URL / AUTH_DATABASE_URL: the *pooled* URL (ends with ?sslmode=require).
#      Both may point at the same Neon database for single-DB setups.
#    - MIGRATE_DATABASE_URL / DIRECT_DATABASE_URL: the *direct* (non-pooled) URL.
#      Migrations and pg-boss workers need it for advisory locks.
# 2. Keep DB_POOL_MAX low on serverless tiers (5 is safe for Neon free).
# 3. TLS is auto-enabled for neon.tech / supabase.co / railway.app / render.com /
#    amazonaws.com hosts, or force it with DATABASE_SSL=true.
#DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/nexus?sslmode=require
#AUTH_DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/nexus?sslmode=require
#MIGRATE_DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/nexus?sslmode=require
#DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/nexus?sslmode=require
#DATABASE_SSL=true
#DB_POOL_MAX=5
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Public API origin used for email tracking pixel / click links.
#API_URL=http://localhost:3001
SMTP_URL=smtp://localhost:1025
# ---- Hosted email (required when fully online; Mailpit is local-only) ----
# Any nodemailer SMTP URL works. Examples:
#   Resend:   smtp://resend:<api-key>@smtp.resend.com:587
#   SendGrid: smtp://apikey:<api-key>@smtp.sendgrid.net:587
#   Brevo:    smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
#   Gmail:    smtp://<address>:<app-password>@smtp.gmail.com:587
#SMTP_URL=smtp://resend:re_xxx@smtp.resend.com:587
#MAIL_FROM=Nexus CRM <noreply@yourdomain.com>
MAIL_FROM=Nexus CRM <noreply@nexus.local>
SESSION_TTL_DAYS=14
# 32 random bytes as hex. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The API refuses to boot without it. CI uses its own throwaway key.
FIELD_ENCRYPTION_KEY=change-me-to-64-hex-chars
# Job queue: set to 0 to disable pg-boss workers/schedules (used by nothing in
# normal operation; tests run against the real queue).
QUEUES_ENABLED=1
# Personal data export download TTL and on-disk storage root.
EXPORT_TTL_DAYS=7
STORAGE_DIR=storage
# ---- Online file storage (Cloudflare R2, recommended for "everything online") ----
# Local disk (STORAGE_DIR) is lost on redeploys of hosted APIs, so production
# online setups must use S3-compatible object storage:
# 1. Cloudflare dashboard → R2 → Create bucket (e.g. nexus-storage).
# 2. R2 → Manage API tokens → create token with Object Read & Write on that bucket.
# 3. Set the vars below (endpoint looks like https://<account-id>.r2.cloudflarestorage.com).
# Layout inside the bucket mirrors local disk: attachments/… exports/… imports/…
#STORAGE_DRIVER=s3
#S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_BUCKET=nexus-storage
#S3_ACCESS_KEY_ID=...
#S3_SECRET_ACCESS_KEY=...
#S3_FORCE_PATH_STYLE=false
# Audit retention floor is 365 days (PRD 4.12); larger values keep rows longer.
AUDIT_RETENTION_DAYS=365
