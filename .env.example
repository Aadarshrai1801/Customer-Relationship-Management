DATABASE_URL=postgres://nexus_app:nexus_app@localhost:5433/nexus
AUTH_DATABASE_URL=postgres://nexus_auth:nexus_auth@localhost:5433/nexus
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/nexus
PORT=3001
WEB_ORIGIN=http://localhost:5173
SMTP_URL=smtp://localhost:1025
SESSION_TTL_DAYS=14
# 32 random bytes as hex. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The API refuses to boot without it. CI uses its own throwaway key.
FIELD_ENCRYPTION_KEY=change-me-to-64-hex-chars
# Job queue: set to 0 to disable pg-boss workers/schedules (used by nothing in
# normal operation; tests run against the real queue).
QUEUES_ENABLED=1
# Personal data export download TTL and on-disk storage root.
EXPORT_TTL_DAYS=7
STORAGE_DIR=storage
# Audit retention floor is 365 days (PRD 4.12); larger values keep rows longer.
AUDIT_RETENTION_DAYS=365
